TAILPATH_AUTHKEY_FILE=./secrets/tailscale-authkey
TAILPATH_HOSTNAME=tailpath
TAILPATH_SERVER_URL=http://tailpath:8080
TAILPATH_RELAY_TELEMETRY=auto
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
TAILPATH_VERSION=latest

# Optional Devices API enrichment. Values are used only with
# `docker compose -f compose.yaml -f compose.devices.yaml ...`.
TAILPATH_DEVICES_OAUTH_CLIENT_ID=
TAILPATH_DEVICES_OAUTH_CLIENT_SECRET_FILE=./secrets/tailscale-devices-oauth-client-secret
TAILPATH_DEVICES_TAILNET=-
